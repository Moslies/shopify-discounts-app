
{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign card_group_id = product.id -%}
  <div 
        class="yx-sub-card"
        style="{% if show_card_shadow %}box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);{% endif %}"
  >
    {% if title != blank %}
      <div class="yx-sub-card__header">
            <div class="yx-sub-card__title">
              <span></span>
              <h3 class="yx-sub-card__title-text">{{ title }}</h3>
              <span></span>
            </div>
      </div>
    {% endif %}
    <div class="yx-sub-card__body">
          <div class="yx-sub-delivery-buttons">
            {%- for selling_plan_group in product.selling_plan_groups -%}
              {%- for plan in selling_plan_group.selling_plans -%}
                {%- assign plan_id = plan.id -%}
                {%- assign plan_name = plan.name -%}
                {%- assign discount_rate = 0 -%}
                {%- for adjustment in plan.price_adjustments -%}
                  {%- if adjustment.value_type == 'percentage' -%}
                    {%- assign discount_rate = adjustment.value -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign discount_percentage = discount_rate | round -%}
                <label class="yx-delivery-btn" 
                  data-plan-id="{{ plan_id }}"
                  data-discount-rate="{{ discount_rate }}"
                  data-plan-name="{{ plan_name | escape }}"
                  data-plan-group-id="{{ card_group_id }}"
                  data-interval="{{ plan.options[0].value | escape }}"
                >
                  <input type="checkbox" name="plan_{{ card_group_id }}" class="yx-delivery-btn__radio" value="{{ plan_id }}">
                  <div class="yx-delivery-btn__content">
                    {% comment %} <span class="yx-delivery-btn__text">{{ plan.options[0].value }}</span> {% endcomment %}
                    {%- if discount_percentage > 0 -%}
                      <div class="yx-delivery-btn__price">
                          <span>Subscribe & save</span>
                          <span class="yx-delivery-btn__badge">SAVE {{ discount_percentage }}%</span>
                      </div>
                    {%- endif -%}
                    <div>{{ plan_name }}</div>
                  </div>
                </label>
              {%- endfor -%}
            {%- endfor -%}
          </div>
    </div>
  </div>
  <input 
        type="radio"
        name="purchase_type_{{ product.id }}"
        value="subscription"
        class="yx-purchase-type-radio"
        data-purchase-type="subscription"
        data-plan-group-id="{{ card_group_id }}"
        style="display: none;"
  >
  <input 
    type="hidden"
    name="selling_plan_{{ product.id }}"
    class="yx-selling-plan-hidden"
    data-plan-group-id="{{ card_group_id }}"
  >
{%- endif -%}

{% style %}

.yx-sub-card {
  padding: var(--card-padding);
  background: #fff;
  cursor: pointer;
  transition: all 0.2s ease;
  margin: auto;
  border-radius: 8px;
}

.yx-sub-card__header {
  gap: 16px;
}

.yx-sub-card__title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  line-height: 1;
  column-gap: 10px;
  margin: 6px 0px;
  color: var(--selected_variant_text_color, #111827);
}
.yx-sub-card__title  span:first-child, .yx-sub-card__title  span:last-child {
  display: block;
  height: 2px;
  flex-grow: 1;
  background: var(--selected_variant_text_color, #d6d8dc);
}
.yx-sub-card__title-text {
  font-size: 18px;
  font-weight: 800;
  margin: 0 0 8px 0;
  color: var(--selected_variant_text_color, #111827);
}

.yx-sub-card__benefits {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 16px;
}

.yx-sub-benefit {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #4b5563;
}

.yx-sub-benefit__icon {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid #93c5fd;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #387cc9;
  flex-shrink: 0;
}

.yx-sub-card__body {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.yx-sub-delivery-buttons {
  wwidth: 100%;
}

.yx-sub-delivery-buttons .yx-delivery-btn {
  width: 100%;
  margin-top: 16px;
  padding: 16px;
  border: 2px dashed var(--selected_variant_border_color, #387cc9);
  border-radius: 8px;
  background: #ffffff;
  cursor: pointer;
  color: #000;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  text-align: left;
}
.yx-delivery-btn input {
  border-color: var(--selected_variant_border_color, initial);
}
.yx-delivery-btn__radio {
  width: 20px;
  height: 20px;
  cursor: pointer;
  flex-shrink: 0;
}

.yx-delivery-btn__content {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.yx-delivery-btn__price {
  display: flex;
  align-items: center;
  gap: 12px;
}
.yx-delivery-btn:hover {
  background: #ffffff;
  border-color: var(--selected_variant_border_color, #387cc9);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
  transform: translateY(-1px);
}

.yx-delivery-btn.selected {
  background: #fff;
  border-color: var(--selected_variant_border_color, #387cc9);
}

.yx-delivery-btn__text {
  display: block;
  font-size: 16px;
  font-weight: 600;
  hyphens: auto;
}

.yx-delivery-btn__badge {
  display: block;
  padding: 0px 6px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  background: var(--selected_variant_border_color, #387cc9);
  color: var(--badge_text_color, #111827);
}

/* .yx-delivery-btn.selected .yx-delivery-btn__badge {
  color: #ffa500;
} */

{% endstyle %}
