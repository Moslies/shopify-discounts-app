{% comment %} bundle-selector.liquid {% endcomment %}
{% assign bundle_config = shop.metafields["discounts-allocator"]["function-configuration"] %}
{% assign tiers_json = '[]' %}
{% if bundle_config %}
  {% assign config = bundle_config.value %}
  {% assign product_gid = 'gid://shopify/Product/' | append: product.id %}
  {% comment %} Collect all tiers from every applicable discount into one flat JSON array {% endcomment %}
  {% assign all_tiers_items = '' %}

  {% for discount in config.discounts %}
    {% if discount.active and discount.scope contains 'product' %}

      {% comment %} Check if this discount applies to the current product {% endcomment %}
      {% assign matches_current = false %}
      {% if discount.productIds == blank or discount.productIds.size == 0 %}
        {% comment %} Empty productIds = applicable to ALL products {% endcomment %}
        {% assign matches_current = true %}
      {% elsif discount.productIds contains product_gid %}
        {% assign matches_current = true %}
      {% endif %}

      {% if matches_current %}
        {% if discount.tiers != blank and discount.tiers.size > 0 %}
          {% comment %} Collect all tiers from this discount {% endcomment %}
          {% for tier in discount.tiers %}
            {% assign tier_json = tier | json | remove: '}' %}
            {% assign tier_entry = tier_json | append: ', "type":"' | append: discount.type | append: '"}' %}
            {% if all_tiers_items != '' %}
              {% assign all_tiers_items = all_tiers_items | append: ',' | append: tier_entry %}
            {% else %}
              {% assign all_tiers_items = tier_entry %}
            {% endif %}
          {% endfor %}
        {% elsif discount.value != blank and discount.minQuantity != blank %}
          {% comment %} Fallback: convert single discount to a tier entry {% endcomment %}
          {% assign fallback_tier = '{"minQuantity":' | append: discount.minQuantity | append: ',"value":"' | append: discount.value | append: '","type":"' | append: discount.type | append: '"}' %}
          {% if all_tiers_items != '' %}
            {% assign all_tiers_items = all_tiers_items | append: ',' | append: fallback_tier %}
          {% else %}
            {% assign all_tiers_items = fallback_tier %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if all_tiers_items != '' %}
    {% assign tiers_json = '[' | append: all_tiers_items | append: ']' %}
  {% else %}
    {% assign tiers_json = '[]' %}
  {% endif %}
{% endif %}

{% if product.variants.size == 1 %}
  {% assign variant_flag = 0 %}
{% else %}
  {% assign variant_flag = 66 %}
{% endif %}

<div 
  class="bundle-selector" 
  data-tiers="{{ tiers_json | escape }}"
  data-compare_at_price="{{ product.selected_or_first_available_variant.compare_at_price }}"
  data-base-price="{{ product.selected_or_first_available_variant.price }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-currency-code="{{ shop.currency }}"
  data-specification="{{ product.options | join: ' / ' | escape }}"
  data-variant-flag="{{ variant_flag | escape }}"
  style="{% if show_card_shadow %}box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);{% endif %}"
>
{% if title != blank %}
  <div class="bundle-title">
    <span></span>
    <span>
      {% comment %} {% if tiers_json != '[]' and tiers_json != blank and tiers_json != null %}
        BUNDLE & SAVE
      {% else %}
        PURCHASE
      {% endif %} {% endcomment %}
      {{ title }}
    </span>
    <span></span>
  </div>
{% endif %}
  {%- comment -%} 默认变体选择器（隐藏，供JS读取） {%- endcomment -%}
  <select class="bundle-single-select" style="display:none;" aria-hidden="true">
    {% for variant in product.variants %}
      <option value="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-compare_at_price="{{ variant.compare_at_price }}"
              data-available="{{ variant.available }}"{% unless variant.available %} disabled{% endunless %}>
        {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
      </option>
    {% endfor %}
  </select>

  {%- comment -%} 阶梯选项（从 metafield 动态渲染）{%- endcomment -%}
  <div id="bundle-tier-options"></div>
</div>

{% style %}
.bundle-selector {
  border-radius: 8px;
  padding: var(--card-padding);
  margin: auto;
  background-color: var(--card-color);
}
#bundle-tier-options {
  width: 100%;
}
.bundle-radio-item {
  display: flex;
  align-items: center;
  gap: 8px;
}
.bundle-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  line-height: 1;
  column-gap: 10px;
  margin: 12px 0px;
  color: var(--selected_variant_text_color, #111827);
}
.bundle-title span:first-child, .bundle-title span:last-child {
  display: block;
  height: 2px;
  flex-grow: 1;
  background: var(--selected_variant_text_color, #d6d8dc);
}
.bundle-option {
  width: 100%;
  display: flex;
  flex-direction: column;
  border: 1px solid #e0e0e0;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
  cursor: pointer;
  position: relative;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  background: #ededed;
}

.bundle-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.bundle-option:hover {
  background: var(--selected_variant_hover_background_color, rgba(59,130,246,0.08));
  border-color: var(--selected_variant_hover_border_color, #93c5fd);
  color: var(--selected_variant_hover_text_color, #111827);
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
  transform: translateY(-1px);
}

.bundle-option:has(input:checked) {
  border-color: var(--selected_variant_border_color, #3b82f6);
  background: var(--selected_variant_background_color, rgba(59,130,246,0.08));
  color: var(--selected_variant_text_color, #111827);
  box-shadow: 0 12px 28px rgba(59,130,246,0.14);
}


.bundle-left {
  flex: 1;
  width: 100%;
}
.bundle-option-content {
  width: 100%;
}

.bundle-name {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: bold;
  font-size: 16px;
}
.bundle-subscribe-item {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  padding-left: 22px;
  padding-top: 10px;
}
.bundle-subscribe-item:before {
  content: "";
  display: block;
  width: 6px;
  height: 6px;
  position: absolute;
  left: 18px;
  top: 16px;
  background: #ededed;
  z-index: 10;
}
.bundle-option:has(input:checked) .bundle-subscribe-item:before {
  background: var(--selected_variant_background_color, rgba(59,130,246,0.08));
}
.bundle-option:hover .bundle-subscribe-item:before {
  background: var(--selected_variant_hover_background_color, rgba(59,130,246,0.08));
}
.bundle-subscribe-item div {
  position: relative;
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  font-weight: 600;
  color: #9CA3AF;
  padding: 0px 6px;
  /* background: var(--selected_variant_border_color, #387cc9);
  color: var(--badge_text_color, #fff); */
}

.bundle-subscribe-item div:before {
  content: "";
  display: inline-block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #9CA3AF;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  left: -2px;
}

.subscribe-item-content {
  display: none;
}

.bundle-option:has(input:checked) .product-discount {
  color: #7C3AED;
}

.bundle-option:has(input:checked) .bundle-desc {
  color: #FFA500;
}

.bundle-option:has(input:checked) .subscribe-item-content {
  color: var(--selected_variant_border_color, #387cc9);
}

.bundle-name:first-child span {
  display: inline-block;
  min-width: 60px;
  text-align: left;
  margin-right: 6px;
}

.bundle-right {
  text-align: right;
}

.bundle-price {
  font-weight: bold;
  font-size: 22px;
}

.bundle-original-price {
  text-decoration: line-through;
  color: #999;
  font-size: 14px;
}

.subscribe-item {
  display: none;
}

/* .bundle-selector.has-subscription .bundle-price-item .bundle-price {
  color: #22c55e;
} */

.bundle-selector.has-subscription .subscribe-item {
  display: block;
}

.bundle-save-badge {
  display: flex;
  gap: 4px;
  padding: 0px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  background: #F0FDF4;
  color: #9CA3AF;
  border: 1px solid #9CA3AF;

}

.bundle-save-badge strong {
  font-size: 12px;
  font-weight: 600;
}

.bundle-option:has(input:checked) .bundle-save-badge {
  background: #A7F3D0;
  color: #166534;
  border: 1px solid #166534;
}

.bundle-save-text {
  font-size: 13px;
  color: #555;
}

.bundle-option .bundle-variant {
  height: 0;
  width: 100%;
  overflow: hidden;
}

.bundle-option:has(input:checked) .bundle-variant {
  height: var(--variant-height);
  transition: all var(--variant-qty) ease;
}

.bundle-option.unavailable {
  border-color: #e0e0e0;
}

.variant-select-wrapper {
  position: relative;
  flex: 1;
  padding-left: 2px;
}

.variant-select-wrapper.unavailable .variant-select {
  border-color: #d32f2f;
  box-shadow: 0 0 0 1px rgba(211, 47, 47, 0.35);
}

.variant-availability-message {
  display: none;
  color: #d32f2f;
  font-size: 12px;
}


.variant-select-wrapper.unavailable .variant-availability-message {
  position: absolute;
  top: 6px;
  left: 10px;
  display: block;
}
/* // todo: 热门套餐索引显示 */
.popular-badge {
  position: absolute;
  top: -12px;
  right: 12px;
  background: var(--selected_variant_border_color, var(--selected-color));
  color: var(--badge_text_color, #111827);
  border-radius: 20px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: bold;
}

.variant-specification {
  position: relative;
  z-index: 11;
  font-size: 12px;
  margin-bottom: 4px;
  color: #777;
}

.bundle-option-index {
  font-weight: bold;
  font-size: 12px;
  display: inline-block;
  width: 20px;
  color: #000;
}

.variant-select {
  padding: 4px 8px;
  padding-right: 20px;
  border: 1px solid #ccc;
  border-radius: 4px;
  width: 66%;
  height: 32px;
  outline: none;
}
.variant-select:focus {
  border: none;
  box-shadow: 0 0 0 2px var(--selected_variant_border_color, var(--selected-color));
}
option:disabled {
  color: #999;
  text-decoration: line-through;
}

/* disabled option 视觉样式 */
.variant-select option:disabled {
  color: #999;
  text-decoration: line-through;
  background-color: #f5f5f5;
}

/* 当前选中项是 disabled 时，整个 select 显示禁止样式 */
.variant-select:has(option:checked:disabled) {
  cursor: not-allowed !important;
  color: #999;
  background-color: #f5f5f5;
}

{% endstyle %}
