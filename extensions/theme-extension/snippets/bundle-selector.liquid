{% comment %} bundle-selector.liquid {% endcomment %}
{% assign bundle_config = shop.metafields["discounts-allocator"]["function-configuration"] %}
{% assign tiers_json = '[]' %}
{% if bundle_config %}
  {% assign config = bundle_config.value %}
  {% assign product_gid = 'gid://shopify/Product/' | append: product.id %}
  {% comment %} Collect all tiers from every applicable discount into one flat JSON array {% endcomment %}
  {% assign all_tiers_items = '' %}

  {% for discount in config.discounts %}
    {% if discount.active and discount.scope contains 'product' %}

      {% comment %} Check if this discount applies to the current product {% endcomment %}
      {% assign matches_current = false %}
      {% if discount.productIds == blank or discount.productIds.size == 0 %}
        {% comment %} Empty productIds = applicable to ALL products {% endcomment %}
        {% assign matches_current = true %}
      {% elsif discount.productIds contains product_gid %}
        {% assign matches_current = true %}
      {% endif %}

      {% if matches_current %}
        {% if discount.tiers != blank and discount.tiers.size > 0 %}
          {% comment %} Collect all tiers from this discount {% endcomment %}
          {% for tier in discount.tiers %}
            {% assign tier_json = tier | json | remove: '}' %}
            {% assign tier_entry = tier_json | append: ', "type":"' | append: discount.type | append: '"}' %}
            {% if all_tiers_items != '' %}
              {% assign all_tiers_items = all_tiers_items | append: ',' | append: tier_entry %}
            {% else %}
              {% assign all_tiers_items = tier_entry %}
            {% endif %}
          {% endfor %}
        {% elsif discount.value != blank and discount.minQuantity != blank %}
          {% comment %} Fallback: convert single discount to a tier entry {% endcomment %}
          {% assign fallback_tier = '{"minQuantity":' | append: discount.minQuantity | append: ',"value":"' | append: discount.value | append: '","type":"' | append: discount.type | append: '"}' %}
          {% if all_tiers_items != '' %}
            {% assign all_tiers_items = all_tiers_items | append: ',' | append: fallback_tier %}
          {% else %}
            {% assign all_tiers_items = fallback_tier %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if all_tiers_items != '' %}
    {% assign tiers_json = '[' | append: all_tiers_items | append: ']' %}
  {% else %}
    {% assign tiers_json = '[]' %}
  {% endif %}
{% endif %}

{% if product.variants.size == 1 %}
  {% assign variant_flag = 0 %}
{% else %}
  {% assign variant_flag = 66 %}
{% endif %}

<div 
  class="bundle-selector" 
  data-tiers="{{ tiers_json | escape }}"
  data-base-price="{{ product.selected_or_first_available_variant.price }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-currency-code="{{ shop.currency }}"
  data-specification="{{ product.options | join: ' / ' | escape }}"
  data-popular_indexs="{{ popular_indexs | escape}}"
  data-variant-flag="{{ variant_flag | escape }}"
  style="{% if show_card_shadow %}box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);{% endif %}"
>
  <div class="bundle-title">
    <span></span>
    <span>
      {% if tiers_json.size > 0 %}
        BUNDLE & SAVE
      {% else %}
        Purchase Options
      {% endif %}
    </span>
    <span></span>
  </div>
  {%- comment -%} Single 选项（原价）{%- endcomment -%}
  <label class="bundle-option" data-qty="1">
    <div class="bundle-left">
        <div class="bundle-option-content">
            <input style="width: 20px; height: 20px;" type="radio" name="bundle-qty" value="1" checked>
            <div>
                <div class="bundle-name">Single</div>
                <div class="bundle-desc">Standard price</div>
            </div>
        
        </div>
        <div class="bundle-variant" style="height: {{ variant_flag }}px;">
              <div class="variant-specification">
                  {{ product.options | join: ' / ' }}
              </div>
              <div class="variant-select-wrapper">
                <select class="bundle-single-select variant-select">
                    {% for variant in product.variants %}
                        <option value="{{ variant.id }}" 
                                data-price="{{ variant.price }}"
                                data-available="{{ variant.available }}"{% unless variant.available %} disabled{% endunless %}>
                            {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                        </option>
                    {% endfor %}
                </select>
                <div class="variant-availability-message"></div>
              </div>
        </div>
    </div>
    
    <div class="bundle-right">
      <div class="bundle-price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>
    </div>
  </label>

  {%- comment -%} 阶梯选项（从 metafield 动态渲染）{%- endcomment -%}
  <div id="bundle-tier-options"></div>
</div>

{% style %}
.bundle-selector {
  border-radius: 8px;
  padding: var(--card-padding);
  margin: auto;
  background-color: var(--card-color);
}
#bundle-tier-options {
  width: 100%;
}
.bundle-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 800;
  line-height: 1;
  column-gap: 10px;
  margin: 16px 0px;
  color: #000;
}
.bundle-title span:first-child, .bundle-title span:last-child {
  display: block;
  height: 2px;
  flex-grow: 1;
  background: var(--selected_variant_text_color);
}
.bundle-option {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  padding: 12px;
  cursor: pointer;
  position: relative;
  transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  background: #ededed;
}

.bundle-option:hover {
  background: var(--selected_variant_hover_background_color);
  border-color: var(--selected_variant_hover_border_color);
  color: var(--selected_variant_hover_text_color);
}

.bundle-option:has(input:checked) {
  border-color: var(--selected_variant_border_color, var(--border-color));
  background: var(--selected_variant_background_color, var(--selected-color));
  color: var(--selected_variant_text_color);
}

.bundle-option:has(input:checked):hover {
  border-color: var(--selected_variant_border_color, var(--border-color));
  background: var(--selected_variant_background_color, var(--selected-color));
  color: var(--selected_variant_text_color);
}

.bundle-left {
  flex: 1;
}
.bundle-option-content {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
}
.bundle-name {
  font-weight: bold;
  font-size: 16px;
}

.bundle-name:first-child span {
  display: inline-block;
  min-width: 60px;
  text-align: left;
  margin-right: 6px;
}

.bundle-desc {
  font-size: 13px;
  color: #777;
}

.bundle-right {
  text-align: right;
}

.bundle-price {
  font-weight: bold;
  font-size: 16px;
}

.bundle-original-price {
  text-decoration: line-through;
  color: #999;
  font-size: 13px;
}

.bundle-save-badge {
  background: #d9d9d9;
  border-radius: 8px;
  padding: 2px 4px;
  font-size: 12px;
  font-weight: bold;
}

.bundle-save-text {
  font-size: 13px;
  color: #555;
}

.bundle-option .bundle-variant {
  height: 0;
  overflow: hidden;
  margin-top: var(--variant-margin-top);
}

.bundle-option:has(input:checked) .bundle-variant {
  height: var(--variant-height);
  transition: all var(--variant-qty) ease;
}
.bundle-option.unavailable {
  border-color: #e0e0e0;
}

.variant-select-wrapper {
  position: relative;
  margin-top: 6px;
  margin-left: 6px;
  flex: 1;
}

.variant-select-wrapper.unavailable .variant-select {
  border-color: #d32f2f;
  box-shadow: 0 0 0 1px rgba(211, 47, 47, 0.35);
}

.variant-availability-message {
  display: none;
  margin-top: 4px;
  padding: 8px;
  border: 1px solid #f5c2c7;
  background: #fdecea;
  border-radius: 6px;
  color: #d32f2f;
  font-size: 13px;
  line-height: 1.4;
}


.variant-select-wrapper.unavailable .variant-availability-message {
  display: block;
}

.popular-badge {
  position: absolute;
  top: -12px;
  right: 12px;
  background: var(--selected_variant_border_color, var(--border-color));
  color: #fff;
  border-radius: 20px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: bold;
}

.variant-specification {
    font-size: 13px;
    color: #777;
}

.bundle-option-index {
  font-weight: bold;
  font-size: 12px;
  display: inline-block;
  width: 20px;
}

.variant-select {
  padding: 4px 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
  width: 77%;
  height: 32px;
  outline: none;
}
.variant-select:focus {
  border: none;
  box-shadow: 0 0 0 2px var(--bar-selected-border-color, #000);
}
option:disabled {
  color: #999;
  text-decoration: line-through;
}

/* disabled option 视觉样式 */
.variant-select option:disabled {
  color: #999;
  text-decoration: line-through;
  background-color: #f5f5f5;
}

/* 当前选中项是 disabled 时，整个 select 显示禁止样式 */
.variant-select:has(option:checked:disabled) {
  cursor: not-allowed !important;
  color: #999;
  background-color: #f5f5f5;
}

{% endstyle %}

<script>
    (function () {
  const container = document.querySelector('.bundle-selector');
  if (!container) return;
  const popular_indexs = parseInt(container.dataset.popular_indexs || '2', 10);
  const specification = container.dataset.specification;
  const tiersRaw = container.dataset.tiers;
  const variantFlag = parseInt(container.dataset.variantFlag || '0', 10);
  const tiers = JSON.parse(tiersRaw || '[]');
  const tierContainer = document.getElementById('bundle-tier-options');
  const variantSelect = container.querySelector('.bundle-single-select');

  /** Merge tiers from multiple discounts: keep the best value per (minQuantity + type), then across types keep the one with larger dollar savings */
  function mergeTiers(rawTiers, basePrice) {
    const map = new Map();
    rawTiers.forEach(tier => {
      const key = tier.minQuantity + '-' + (tier.type || 'percentage');
      const val = parseFloat(tier.value);
      if (!map.has(key) || val > parseFloat(map.get(key).value)) {
        map.set(key, { ...tier });
      }
    });

    // Same minQuantity, different types — compare effective savings in cents
    const byQty = new Map();
    for (const tier of map.values()) {
      const existing = byQty.get(tier.minQuantity);
      if (!existing) { byQty.set(tier.minQuantity, tier); continue; }
      const existingSavings = existing.type === 'fixed_amount'
        ? parseFloat(existing.value) * 100 * existing.minQuantity
        : basePrice * existing.minQuantity * (parseFloat(existing.value) / 100);
      const tierSavings = tier.type === 'fixed_amount'
        ? parseFloat(tier.value) * 100 * tier.minQuantity
        : basePrice * tier.minQuantity * (parseFloat(tier.value) / 100);
      if (tierSavings > existingSavings) byQty.set(tier.minQuantity, tier);
    }
    return Array.from(byQty.values()).sort((a, b) => a.minQuantity - b.minQuantity);
  }

  function getSelectPrice(select) {
    const selected = select.options[select.selectedIndex];
    return parseInt(selected.dataset.price || '0', 10);
  }

  function getCurrencyCode() {
    return container.dataset.currencyCode || (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
  }

  function updateCurrencyCode(code) {
    if (!code) return;
    container.dataset.currencyCode = code;
  }

  function buildVariantSelects(qty) {
    const optionsHtml = Array.from(variantSelect.options)
      .map((opt) => `
            <option value="${opt.value}" data-price="${opt.dataset.price}" data-available="${opt.dataset.available}" ${opt.disabled ? 'disabled' : ''} ${opt.value === variantSelect.value ? 'selected' : ''}>
              ${opt.text}
            </option>`)
      .join('');

    return Array.from({ length: qty }, (_, index) => `
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="bundle-option-index" style="display: ${qty === 1 ? 'none' : 'block'};">#${index + 1}</span>
            <div class="variant-select-wrapper">
              <select class="bundle-tier-select variant-select" data-index="${index + 1}">
                  ${optionsHtml}
              </select>
              <div class="variant-availability-message"></div>
            </div>
          </div>
        `).join('');
  }

  function formatMoney(cents) {
    const currency = getCurrencyCode();
    const amount = (cents / 100).toFixed(2);
    const currencySymbols = {
      USD: '$',
      CAD: '$',
      AUD: '$',
      NZD: '$',
      HKD: '$',
      SGD: '$',
      EUR: '€',
      GBP: '£',
      JPY: '¥',
      CNY: '¥',
      SEK: 'kr',
      NOK: 'kr',
      DKK: 'kr',
      CHF: 'CHF',
      KRW: '₩',
      INR: '₹',
    };

    if (currencySymbols[currency]) {
      return `${currencySymbols[currency]}${amount}`;
    }

    try {
      const formatted = new Intl.NumberFormat(navigator.language || 'en-US', {
        style: 'currency',
        currency,
        currencyDisplay: 'symbol',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(cents / 100);
      return formatted.replace(/\s*([A-Z]{2,3})\s*/g, '').trim();
    } catch (error) {
      return `${currency} ${amount}`;
    }
  }

  function updateSinglePrice() {
    const priceEl = container.querySelector('.bundle-option[data-qty="1"] .bundle-price');
    if (!priceEl) return;
    priceEl.textContent = formatMoney(getSelectPrice(variantSelect));
  }

  function updateTierPrice(label) {
    const tierSelects = Array.from(label.querySelectorAll('.bundle-tier-select'));
    const originalTotal = tierSelects.reduce((sum, select) => sum + getSelectPrice(select), 0);
    const discountValue = parseFloat(label.dataset.discountValue || '0');
    const discountType = label.dataset.discountType || 'percentage';

    let discountedTotal, savedAmount;
    if (discountType === 'fixed_amount') {
      const qty = tierSelects.length;
      const discountCents = discountValue * 100 * qty;
      discountedTotal = Math.max(0, originalTotal - discountCents);
      savedAmount = originalTotal - discountedTotal;
    } else {
      discountedTotal = Math.round(originalTotal * (1 - discountValue / 100));
      savedAmount = originalTotal - discountedTotal;
    }

    label.querySelector('.bundle-price').textContent = formatMoney(discountedTotal);
    label.querySelector('.bundle-original-price').textContent = formatMoney(originalTotal);
    const saveBadge = label.querySelector('.bundle-save-badge');
    if (saveBadge) {
      saveBadge.textContent = `SAVE ${formatMoney(savedAmount)}`;
    }
  }

  function isOptionAvailable(option) {
    return option && (option.dataset.available === 'true' || option.dataset.available === true);
  }

  function updateAvailability(select) {
    const option = select.options[select.selectedIndex];
    const wrapper = select.closest('div');
    const messageEl = wrapper?.querySelector('.variant-availability-message');
    const selectWrapper = select.closest('.variant-select-wrapper');

    if (!messageEl) return;

    if (!isOptionAvailable(option)) {
      messageEl.textContent = 'Sorry, This variant is sold out, please choose another option.';
      if (selectWrapper) selectWrapper.classList.add('unavailable');
    } else {
      messageEl.textContent = '';
      if (selectWrapper) selectWrapper.classList.remove('unavailable');
    }
  }

  function updateAllAvailability() {
    updateAvailability(variantSelect);
    Array.from(container.querySelectorAll('.bundle-tier-select')).forEach(updateAvailability);
  }

  function attachTierSelectListeners(label) {
    Array.from(label.querySelectorAll('.bundle-tier-select')).forEach((select) => {
      select.addEventListener('change', () => {
        updateTierPrice(label);
        updateAvailability(select);
      });
    });
  }

  // 渲染阶梯选项
  function renderTiers() {
    tierContainer.innerHTML = '';

    const tierNames = ['', 'Single', 'Duo', 'Trio', 'Quad'];
    const hasQty1Tier = tiers.some(t => t.minQuantity === 1);
    const popularIndex = (popular_indexs - 2) + (hasQty1Tier ? 1 : 0); // qty=1 tier 会占掉索引0，popular 标记后移一位
    const basePrice = getSelectPrice(variantSelect);
    const mergedTiers = mergeTiers(tiers, basePrice);
    mergedTiers.forEach((tier, index) => {
      const qty = tier.minQuantity;
      const discountValue = parseFloat(tier.value);
      const discountType = tier.type || 'percentage';
      const originalTotal = basePrice * qty;

      let discountedTotal, savedAmount;
      if (discountType === 'fixed_amount') {
        const discountCents = discountValue * 100 * qty;
        discountedTotal = Math.max(0, originalTotal - discountCents);
        savedAmount = originalTotal - discountedTotal;
      } else {
        discountedTotal = Math.round(originalTotal * (1 - discountValue / 100));
        savedAmount = originalTotal - discountedTotal;
      }

      const name = tierNames[qty] || `${qty} Pack`;
      const isPopular = index === popularIndex;

      const label = document.createElement('label');
      label.className = 'bundle-option';
      label.dataset.qty = qty;
      label.dataset.discountValue = discountValue;
      label.dataset.discountType = discountType;
      label.style.marginTop = '12px';
      label.innerHTML = `
        <div class="bundle-left">
          <div class="bundle-option-content">
            <input style="width: 20px; height: 20px;" type="radio" name="bundle-qty" value="${qty}">
            <div>
              <div class="bundle-name">
                <span>${name}</span>
                <span class="bundle-save-badge">SAVE ${formatMoney(savedAmount)}</span>
              </div>
              <div class="bundle-desc">${discountType === 'fixed_amount' ? `Save ${formatMoney(discountValue * 100)} off each` : `save ${discountValue}% off`}</div>
            </div>
          </div>
          <div class="bundle-variant" style="--variant-height: ${variantFlag ? (qty * 38 + 28 + 'px') : 0}; --variant-margin-top: ${variantFlag ? '8px' : '0'}; --variant-qty: ${qty * 0.05 + 0.1}s;">
            <div class="variant-specification">${specification}</div>
            ${buildVariantSelects(qty)}
          </div>
        </div>
        <div class="bundle-right">
          <div class="bundle-price">${formatMoney(discountedTotal)}</div>
          <div class="bundle-original-price">${formatMoney(originalTotal)}</div>
        </div>
        ${isPopular ? '<div class="popular-badge">Most Popular</div>' : ''}
      `;
      tierContainer.appendChild(label);
      attachTierSelectListeners(label);
    });
  }

  // 加密id获取
    /**
   * 将数字加密成类似 bid 的 4 位短字符串
   * @param {number} number - 需要加密的数字（如折扣、价格、ID）
   * @param {string} salt - 盐值/密钥，用于增加破解难度，保持固定即可
   * @returns {string} 4位加密字符串
   */
  function generateBid(number, salt = "my_secret_key") {
      // 1. 将数字和盐值拼接，并计算一个简易的哈希值（MurmurHash 或 DJB2 变体）
      let str = number.toString() + salt;
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
          hash = (hash << 5) - hash + str.charCodeAt(i);
          hash |= 0; // 转换为 32 位整数
      }
      
      // 确保是正数
      hash = Math.abs(hash);

      // 2. 自定义字符集（包含大小写字母、数字和特殊字符，共 64 个）
      // 你可以随意打乱这个字符串的顺序，这样别人就更猜不到规律了
      const charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
      
      // 3. 取出哈希值的一部分，映射成 4 位字符串
      let bid = "";
      for (let i = 0; i < 4; i++) {
          // 每次取 hash 的一部分，对 64 取模，得到字符集中的一个字符
          bid += charset[hash % 64];
          hash = Math.floor(hash / 64);
      }
      
      return bid;
  }
  // 获取选中的套餐变体
  getBundleSelectedVariants = () => {
    const selectedQty = parseInt(
      document.querySelector('input[name="bundle-qty"]:checked')?.value || '1',
      10
    );
    const selectedRadio = document.querySelector('input[name="bundle-qty"]:checked');
    let lineItems = [];

    const selectedLabel = selectedRadio.closest('.bundle-option'); // 获取当前选中的容器
    if (selectedQty === 1 && selectedLabel.dataset.qty === '1') {
      lineItems = [{
        id: parseInt(variantSelect.value, 10),
        quantity: 1,
        properties: {
          _yx_bundles: JSON.stringify({ deal: 'VIR1',main: true, bid: generateBid(selectedLabel.dataset.qty) })
        }
      }];
    } else {
      const tierSelects = Array.from(selectedLabel.querySelectorAll('.bundle-tier-select'));
      lineItems = tierSelects.map((select) => ({
        id: parseInt(select.value, 10),
        quantity: 1,
        properties: {
          _yx_bundles: JSON.stringify({ deal: 'VIR1',main: true, bid: generateBid(selectedLabel.dataset.qty) + generateBid(selectedLabel.dataset.discountValue) + generateBid(selectedLabel.dataset.discountType) })
        }
      }));
    }
    return lineItems;
  }
  function updateAllTierPrices() {
    const tierLabels = Array.from(container.querySelectorAll('.bundle-option')).filter((label) => label.dataset.qty !== '1');
    tierLabels.forEach((label) => updateTierPrice(label));
  }

  function handleCurrencyChange(event) {
    const newCurrency = event?.detail?.currency || (window.Shopify && window.Shopify.currency && window.Shopify.currency.active);
    if (newCurrency) {
      updateCurrencyCode(newCurrency);
      updateSinglePrice();
      updateAllTierPrices();
      updateAllAvailability();
    }
  }

  // 变体切换时重新计算价格和可用性提示
  variantSelect.addEventListener('change', () => {
    updateSinglePrice();
    updateAllTierPrices();
    updateAvailability(variantSelect);
    updateAllAvailability();
  });

  document.addEventListener('currency:change', handleCurrencyChange);
  document.addEventListener('currencyChanged', handleCurrencyChange);
  document.addEventListener('shopify:currency:change', handleCurrencyChange);
  document.addEventListener('shopify:currencyChanged', handleCurrencyChange);

  // 初始渲染
  renderTiers();
  // 如果已有数量1的阶梯优惠，隐藏默认 Standard price 选项并切换到 tier radio
  if (tiers.some(t => t.minQuantity === 1)) {
    const singleEl = container.querySelector('.bundle-option[data-qty="1"]');
    if (singleEl) {
      singleEl.style.display = 'none';
      const tierRadio = container.querySelector('#bundle-tier-options .bundle-option[data-qty="1"] input[type="radio"]');
      if (tierRadio) tierRadio.checked = true;
    }
  }
  updateSinglePrice();
  updateAllTierPrices();
  updateAllAvailability();
  handleCurrencyChange();
})();
</script>
<script>
const originalFetch = window.fetch;
window.fetch = async function(url, options = {}) {
  if (typeof url === 'string' && url.includes('/cart/add') && options.method === 'POST') {
    
    const body = options.body;

    if (body instanceof FormData && body.get('form_type') === 'product') {

      const myBundleItems = getBundleSelectedVariants();
      if (myBundleItems.length === 0) {
        return originalFetch(url, options);
      }

      const newFormData = new FormData();

      // ✅ 保留原始头部字段（kaching 需要这些）
      newFormData.append('form_type', body.get('form_type'));
      newFormData.append('utf8', body.get('utf8'));
      newFormData.append('product-id', body.get('product-id'));
      newFormData.append('section-id', body.get('section-id'));
      newFormData.append('sections', body.get('sections'));

      // ✅ 追加你的 bundle items
      myBundleItems.forEach((item, i) => {
        newFormData.append(`items[${i}][id]`, item.id);
        newFormData.append(`items[${i}][quantity]`, item.quantity || 1);
        newFormData.append(
          `items[${i}][properties][_yx_bundles]`,
          item.properties._yx_bundles
        );
        if(body.get('selling_plan')) {
          newFormData.append(`items[${i}][selling_plan]`, body.get('selling_plan'));
        }
      });

      return originalFetch(url, { ...options, body: newFormData });
    }
  }

  return originalFetch(url, options);
};

</script>
