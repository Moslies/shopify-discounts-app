<script src="{{ 'theme.js' | asset_url }}" async></script>
{%- assign card_color = block.settings.card_color | default: '#ffffff' -%}
{%- assign selected_color = block.settings.selected_color | default: '#fff' -%}
{%- assign popular_indexs = block.settings.popular_indexs | default: 2 -%}
{%- assign card_padding = block.settings.card_padding | default: 16 -%}
{%- assign show_card_shadow = block.settings.show_card_shadow | default: false -%}

<theme-container data-shop-url="{{ shop.url }}" 
  style="
    --card-color: {{ card_color }};
    --selected-color: {{ selected_color }};
    --card-padding: {{ card_padding }}px;
    --show-card-shadow: {{ show_card_shadow }};
  "
>
    {% render 'bundle-selector', popular_indexs: popular_indexs, show_card_shadow: show_card_shadow%}
</theme-container>

{% schema %}
{
  "name": "bundle-selector",
  "target": "section",
  "settings": [
    {
      "type": "number",
      "id": "popular_indexs",
      "label": "热门套餐索引",
      "default": 2
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "selected_color",
      "label": "selected_background",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "card_padding",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_card_shadow",
      "label": "show_card_shadow",
      "default": true
    }
  ]
}
{% endschema %}