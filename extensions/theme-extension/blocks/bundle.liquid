<script src="{{ 'theme.js' | asset_url }}" defer></script>
<script src="{{ 'bundle-selector-widget.js' | asset_url }}" defer></script>

{%- assign card_color = block.settings.card_color | default: '#ffffff' -%}
{%- assign selected_color = block.settings.selected_color | default: '#fff' -%}
{%- assign card_padding = block.settings.card_padding | default: 16 -%}
{%- assign show_card_shadow = block.settings.show_card_shadow | default: false -%}
{%- assign all_badge_style = block.settings.all_badge_style | default: 'Style-1' -%}
{%- assign badges_style_list = block.settings.badges_style_list | default: '[empty]' -%}
{%- assign all_badge_position = block.settings.all_badge_position | default: 'upper-right-corner' -%}
{%- assign badges_position_list = block.settings.badges_position_list | default: '[empty]' -%}

<theme-container data-shop-url="{{ shop.url }}" 
  style="
    --card-color: {{ card_color }};
    --selected-color: {{ selected_color }};
    --card-padding: {{ card_padding }}px;
  "
>
    <bundle-selector-widget>
      {% render 'bundle-selector', title: block.settings.title, show_card_shadow: show_card_shadow, all_badge_style: all_badge_style, badges_style_list: badges_style_list, all_badge_position: all_badge_position, badges_position_list: badges_position_list, %}
    </bundle-selector-widget>
</theme-container>

{% schema %}
{
  "name": "bundle-selector",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "title",
      "default": "BUNDLE &amp; SAVE"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "selected_color",
      "label": "selected_background",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "card_padding",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_card_shadow",
      "label": "show_card_shadow",
      "default": true
    },
    {
      "type": "select",
      "id": "all_badge_style",
      "label": "All badges style",
      "options": [
        {
          "value": "Style-1",
          "label": "Style-1"
        },
        {
          "value": "Style-2",
          "label": "Style-2"
        },
        {
          "value": "Style-3",
          "label": "Style-3"
        },
        {
          "value": "Style-4",
          "label": "Style-4"
        },
      ],
      "default": "Style-1",
      "info": "If the next setting is configured, this setting will be overridden"
    },
    {
      "type": "text",
      "id": "badges_style_list",
      "label": "Badges style per product",
      "default": "[empty],[empty]",
      "info": "Set badge style for each product individually, separated by commas. eg: Style-1, [empty], Style-2"
    },
    {
      "type": "select",
      "id": "all_badge_position",
      "label": "All badges position",
      "options": [
        {
          "value": "upper-right-corner",
          "label": "upper-right-corner"
        },
        {
          "value": "right-tilt",
          "label": "right-tilt"
        },
        {
          "value": "left-tilt",
          "label": "left-tilt"
        }
      ],
      "default": "upper-right-corner",
      "info": "If the next setting is configured, this setting will be overridden"
    },
    {
      "type": "text",
      "id": "badges_position_list",
      "label": "Badges position per product",
      "default": "[empty],[empty]",
      "info": "Set badge position for each product individually, separated by commas. eg: upper-right-corner, [empty], right-tilt"
    }
  ]
}
{% endschema %}