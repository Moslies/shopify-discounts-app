<script src="{{ 'theme.js' | asset_url }}" defer></script>
<script src="{{ 'bundle-selector-widget.js' | asset_url }}" defer></script>

{%- assign card_color = block.settings.card_color | default: '#ffffff' -%}
{%- assign selected_color = block.settings.selected_color | default: '#fff' -%}
{%- assign card_padding = block.settings.card_padding | default: 16 -%}
{%- assign show_card_shadow = block.settings.show_card_shadow | default: false -%}

<theme-container data-shop-url="{{ shop.url }}" 
  style="
    --card-color: {{ card_color }};
    --selected-color: {{ selected_color }};
    --card-padding: {{ card_padding }}px;
  "
>
    <bundle-selector-widget>
      {% render 'bundle-selector', title: block.settings.title, show_card_shadow: show_card_shadow%}
    </bundle-selector-widget>
</theme-container>

{% schema %}
{
  "name": "bundle-selector",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "title",
      "default": "BUNDLE &amp; SAVE"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "selected_color",
      "label": "selected_background",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "card_padding",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_card_shadow",
      "label": "show_card_shadow",
      "default": true
    },
    {
      "type": "select",
      "id": "breaks_badge_style",
      "label": "All Badges style",
      "options": [
        {
          "value": "1",
          "label": "Style 1"
        },
        {
          "value": "2",
          "label": "Style 2"
        },
        {
          "value": "3",
          "label": "Style 3"
        }
      ],
      "default": "1",
      "info": "If the next setting is configured, this setting will be overridden"
    },
    {
      "type": "text",
      "id": "breaks_badges",
      "label": "Badges style per product",
      "default": "[empty], [empty]",
      "info": "Set badge style for each product individually, separated by commas. eg: Style 1, [empty], Style 2"
    }
  ]
}
{% endschema %}