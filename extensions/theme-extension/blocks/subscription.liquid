{%- comment -%}
  my-subscription.liquid
  Subscription plan selector component
{%- endcomment -%}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
<script src="{{ 'subscription-selector-widget.js' | asset_url }}" defer></script>

{%- assign show_card_shadow = block.settings.show_card_shadow | default: false -%}
{%- assign card_padding = block.settings.card_padding | default: 16 -%}

<theme-container
 class="yx-subscription-wrapper"
 data-shop-url="{{ shop.url }}"
 style="
    --card-padding: {{ card_padding }}px;
  "
>
  <subscription-selector-widget>
    {% render 'subscription-selector', show_card_shadow: show_card_shadow %}
  </subscription-selector-widget>
</theme-container>
{% style %}
    .yx-subscription-wrapper {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
    }
{% endstyle %}
{% schema %}
{
  "name": "subscription",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "card_padding",
      "label": "card_padding",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_card_shadow",
      "label": "show_card_shadow",
      "default": true
    }
  ]
}
{% endschema %}
