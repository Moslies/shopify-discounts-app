{%- assign card_color = block.settings.card_color | default: '#ffffff' -%}
{%- assign selected_color = block.settings.selected_color | default: '#fff' -%}
{%- assign border_color = block.settings.border_color | default: '#93c5fd' -%}
{%- assign popular_indexs = block.settings.popular_indexs | default: 2 -%}

<div 
    style="
    --card-color: {{ card_color }};
    --selected-color: {{ selected_color }};
    --border-color: {{ border_color }};
    "
>
  {% render 'bundle-selector', popular_indexs: popular_indexs %}
</div>



{% style %}
  .bundle-selector {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bundle-selector__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--card-border-color);
    border-radius: 0.5rem;
    background-color: var(--card-color);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }


  .bundle-selector__card.selected {
    background-color: var(--card-selected-color);
  }
{% endstyle %}  

{% schema %}
{
  "name": "bundle-selector",
  "target": "section",
  "settings": [
    {
      "type": "number",
      "id": "popular_indexs",
      "label": "热门套餐索引",
      "default": 2
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "selected_color",
      "label": "selected_background",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "selected_border_color",
      "default": "#000"
    }

  ]
}
{% endschema %}